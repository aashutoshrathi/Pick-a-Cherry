{
  "manifest_version": 3,
  "name": "Pick-a-Cherry",
  "author": "Aashutosh Rathi",
  "version": "1.1",
  "description": "Adds a cherry icon next to GitHub commits for easy cherry-picking",
  "permissions": ["clipboardWrite"],
  "default_locale": "en",
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
